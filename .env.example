
# HTTP and WebSocket
HTTP_ADDR=:8080

# TCP progress synchronization
TCP_ADDR=:9090

# UDP notifications (Member 2)
UDP_ADDR=:9091

# gRPC Catalog Service
GRPC_ADDR=:9092
GRPC_TARGET=localhost:9092

# SQLite database files
BACKEND_DB_PATH=data/backend.db
CATALOG_DB_PATH=data/catalog.db

# JWT authentication
JWT_SECRET=CHANGE_ME_USE_32_RANDOM_CHARACTERS_OR_MORE
JWT_TTL_HOURS=24
